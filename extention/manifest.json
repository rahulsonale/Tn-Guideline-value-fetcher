{
  "manifest_version": 3,
  "name": "TN Guideline Value Fetcher",
  "version": "1.0.0",
  "description": "Fetch Tamil Nadu guideline values from TNREGINET.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://tnreginet.gov.in/*", "http://localhost:3000/*"],
  "action": {
    "default_title": "TN Guideline Value Fetcher",
    "default_popup": "popup/index.html"
  }
}

